# Copy these settings into the existing Deno server's private .env file.
# Use the same server-to-server secret as the panel; this is not a device token.
MANAGEMENT_BASE_URL=https://your-panel.example
MANAGEMENT_ADAPTER_SECRET=
MANAGEMENT_ALLOW_LOCAL_HTTP=false
AI_PROVIDER=qwen
VOICE_PROVIDER=qwen
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=ap-southeast-1
QWEN_REALTIME_MODEL=qwen3.8-omni-flash-realtime
QWEN_VOICE=Tina
QWEN_REALTIME_URL=
# The existing server still owns its legacy auth, routes, host, and port.
# For its local development listener only:
# DEV_MODE=True
# HOST=127.0.0.1
# PORT=8000
