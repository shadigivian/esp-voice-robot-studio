{
  "name": "esp-voice-management",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --webpack --hostname 127.0.0.1 --port 3100",
    "build": "node node_modules/next/dist/bin/next build --webpack",
    "start": "node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "test": "node --import tsx --test tests/*.test.ts integration/deno/*.test.mjs",
    "test:ui": "node node_modules/@playwright/test/cli.js test",
    "ui:reference": "node scripts/inspect-reference.mjs",
    "ui:capture": "node scripts/capture-ui.mjs after",
    "migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "worker": "node --env-file=.env.local --import tsx scripts/worker.ts",
    "demo": "node scripts/run-demo.mjs",
    "operator": "node --env-file=.env.local --import tsx scripts/operator.ts",
    "simulator": "node --env-file=.env.local scripts/device-simulator.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.4.2",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "eslint": "^10.13.0",
    "node": "22.23.3",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
