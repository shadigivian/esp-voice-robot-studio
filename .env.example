# Server only. Copy to .env.local; never commit real values.
APP_MODE=production
APP_BASE_URL=http://localhost:3100
PRODUCT_NAME=پنل ربات‌های صوتی
# Existing Supabase Auth and its PostgreSQL database. Use a trusted server DB role
# owning the robot_* tables. Never expose DATABASE_URL to the browser.
DATABASE_URL=postgresql://server_role:replace_me@localhost:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_with_public_anon_key
# Qwen cloud is the default in this example. Existing OpenAI deployments may set
# AI_PROVIDER=openai. Never put a DashScope API key on the ESP or in the browser.
AI_PROVIDER=qwen
VOICE_PROVIDER=qwen
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
# Supported realtime regions: ap-southeast-1 (Singapore), cn-beijing (Beijing).
DASHSCOPE_REGION=ap-southeast-1
QWEN_TEXT_MODEL=qwen3.8-omni-flash
QWEN_REALTIME_MODEL=qwen3.8-omni-flash-realtime
QWEN_VOICE=Tina
# Optional workspace endpoints. Leave blank to derive them from workspace/region.
QWEN_BASE_URL=
QWEN_REALTIME_URL=
# Leave blank until intentionally configured. No model access is assumed.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_TTS_MODEL=
OPENAI_REALTIME_MODEL=
OPENAI_VOICE=
OPENAI_TRANSCRIPTION_MODEL=
# Existing Deno server; no browser-provided endpoint is accepted.
VOICE_SERVER_URL=wss://your-existing-voice-server.example/managed-voice
MANAGEMENT_ADAPTER_SECRET=
PRIVATE_STORAGE_DIR=.local/private-files
HEARTBEAT_TIMEOUT_SECONDS=60
MAX_SESSION_SECONDS=600
MAX_CONCURRENT_SESSIONS=2
MAX_SESSIONS_PER_HOUR=30
MAX_DEVICES=50
MAX_DEVICE_SESSIONS_PER_DAY=200
MAX_DEVICE_TOKENS_PER_DAY=1000000
MAX_WORKSPACE_TOKENS_PER_DAY=10000000
MAX_DEVICE_VOICE_SECONDS_PER_DAY=36000
MAX_DOCUMENTS_PER_DEVICE=100
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=100
MAX_DOCUMENT_CHARACTERS=500000
MAX_DOCUMENT_TEXT_CHARS=500000
PDF_PARSE_TIMEOUT_MS=15000
# Optional: demo only, shared if running multiple development processes.
DEMO_SESSION_SECRET=
# Operator command only: unique per-device secret, at least 32 random bytes.
# Supply temporarily through a secure shell/session; do not use a shared key.
DEVICE_BOOTSTRAP_SECRET=
